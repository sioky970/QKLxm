# 开发环境Dockerfile - 支持热重载
FROM golang:1.21-alpine

# 安装必要工具
RUN apk add --no-cache git make

# 安装Air
RUN go install github.com/air-verse/air@latest

# 设置工作目录
WORKDIR /app

# 复制go.mod和go.sum（利用Docker缓存）
COPY go.mod go.sum ./
RUN go mod download

# 暴露端口
EXPOSE 8080 8081

# 使用Air启动（会监听挂载的代码目录）
CMD ["air", "-c", ".air.toml"]
